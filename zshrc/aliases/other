#########################
# Aliases - Tools & Utilities
#########################
alias bat='batcat'
alias bat2='batcat --style=plain'
alias copythis='xsel --input --clipboard'
alias pastethis='xsel --output --clipboard'
alias xterm='xterm -fg white -bg black -fa "Monospace" -fs 14'
alias curlweather='curl wttr.in'
alias curlweather2='curl v2d.wttr.in'
alias commonports='cat /etc/unicornscan/ports.txt'
alias commonport='w3m https://en.wikipedia.org/wiki/List_of_TCP_and_UDP_port_numbers'
alias gpgverify='gpg --show-keys --fingerprint key.asc'
alias ytdl='yt-dlp'
alias ytdlm='yt-dlp --extract-audio --audio-format mp3 --audio-quality 0'
alias prompt='PS1="User@System:/# "'
alias prompttarget='PS1="User@TARGET:/# "'
alias promptattacker='PS1="User@ATTACKER:/# "'
alias installedapps='dpkg-query -l'
alias shell='echo "$SHELL" && ps -p $$'
alias gui='ls /usr/bin/*session'
alias clearhistory='echo "" > ~/.zsh_history & exec $SHELL -l'
alias reload='source ~/.zshrc'
alias displayhere='export DISPLAY=:0'
alias guix='echo "control+f8 for menu"; sleep 2; kex --win'
alias power='upower -d'
alias diskspace='pydf'
alias diskscan='ncdu'
alias setvol='amixer set Master'
