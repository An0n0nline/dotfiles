#########################
# Aliases - Network Monitoring
#########################
alias netwatchx='watch -n 2 "echo \"=== TOP SOURCE IPS ===\" && ss -tan | awk \"{print \$5}\" | cut -d: -f1 | sort | uniq -c | sort -nr | head -8 && echo \"\" && echo \"=== TOP TARGET PORTS ===\" && ss -tan | awk \"{print \$4}\" | cut -d: -f2 | sort | uniq -c | sort -nr | head -8 && echo \"\" && echo \"=== SYN-RECV (Stealth Scan) ===\" && ss -tn state syn-recv | wc -l && echo \"=== ESTABLISHED CONNECTIONS ===\" && ss -tan state established | wc -l"'
alias netwatch0='watch -n 1 "ss -tan | awk \"{print \$5}\" | cut -d: -f1 | sort | uniq -c | sort -nr | head -15"'
alias netwatch1='sudo tcpdump -i any -nxx'
alias netwatch2='sudo ngrep -i'
alias netwatch3='sudo netstat -plunt | grep -v unix'
alias netwatch4='sudo lsof -i -a'
alias netwatch5='sudo bash ~/Scripts/netwatch5.sh'
alias netwatch6='sudo tcpdump -i any -nn'
alias netwatch7='ss -tunap'
alias netwatch8='watch -n 1 "ss -tan | awk \"{print \$4}\" | cut -d: -f2 | sort | uniq -c | sort -nr | head -15"'
alias netwatch55='watch -n 1 "ss -tan | grep ESTAB | awk \"{print \$4}\" | cut -d: -f2 | sort | uniq -c | sort -nr | head -10"'
alias netwatch66='watch -n 1 "ss -tan | grep -v ESTAB | grep -v LISTEN | awk \"{print \$5}\" | cut -d: -f1 | sort | uniq -c | sort -nr | head -10"'
alias netwatch77='watch -n 1 "ss -tan | grep ESTAB | awk \"{print \$5}\" | cut -d: -f1 | sort | uniq -c | sort -nr | head -10"'
alias netwatch99='watch -n 1 "ss -tn state syn-recv | awk \"{print \$4}\" | cut -d: -f1 | sort | uniq -c | sort -nr"'
alias netwatchalert='watch -n 2 "ss -tan | awk \"{print \$5}\" | cut -d: -f1 | sort | uniq -c | sort -nr | head -5 | while read count ip; do if [ \$count -gt 5 ]; then echo \"⚠️ ALERT: \$ip has \$count connections\"; fi; done"'
alias nettools='sudo bash ~/Scripts/nettools-ng.sh'
alias netcheck='sudo netstat -aon --program | grep -v unix'
alias netpeek='bash ~/Scripts/netpeek.sh'
alias flowx='cd ~/FlowSentinel && sudo ./target/release/flowsentinel'
alias taillogs='tail -f /var/log/apache2/access.log'
alias netwatchmd='glow /home/user/Documents/netwatch.md'
